#!/usr/bin/env bash
# bin/release adapter: print the current version, or write a new one into every
# tracked file that carries it (Cargo.toml, the zazu-sdk entry in Cargo.lock, and
# the VERSION constant in src/client.rs).
set -euo pipefail
cd "$(dirname "$0")/.."

if [ $# -eq 0 ]; then
  sed -nE '/^\[package\]/,/^\[/ s/^version = "([^"]+)"$/\1/p' Cargo.toml
  exit 0
fi

new="$1"
# Only the [package] version line, never a dependency's `version = `.
awk -v v="$new" '
  /^\[/ { in_pkg = ($0 == "[package]") }
  in_pkg && /^version = "/ { print "version = \"" v "\""; next }
  { print }
' Cargo.toml > Cargo.toml.tmp && mv Cargo.toml.tmp Cargo.toml

# Cargo.lock: bump only the crate's own entry.
awk -v v="$new" '
  /^name = / { own = ($0 == "name = \"zazu-sdk\"") }
  own && /^version = "/ { print "version = \"" v "\""; own = 0; next }
  { print }
' Cargo.lock > Cargo.lock.tmp && mv Cargo.lock.tmp Cargo.lock

sed -i.bak -E "s/^pub const VERSION: &str = \"[^\"]+\";$/pub const VERSION: \&str = \"$new\";/" src/client.rs
rm -f src/client.rs.bak
